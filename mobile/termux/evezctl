#!/data/data/com.termux/files/usr/bin/bash
set -eo pipefail

CFG="$HOME/.config/evez-mobile.env"
if [ -f "$CFG" ]; then
  . "$CFG"
fi

EVEZ_NODE_ID="${EVEZ_NODE_ID:-evez-a16}"
EVEZ_OBSERVATION_URL="${EVEZ_OBSERVATION_URL:-}"
EVEZ_NEXTCLAW_URL="${EVEZ_NEXTCLAW_URL:-}"
EVEZ_OPENCLAW_URL="${EVEZ_OPENCLAW_URL:-}"
EVEZ_HERMES_URL="${EVEZ_HERMES_URL:-}"
EVEZ_RELAY_TOKEN="${EVEZ_RELAY_TOKEN:-}"
EVEZ_RUVIEW_URL="${EVEZ_RUVIEW_URL:-https://vmi3544756.mooneye-shade.ts.net}"

[ "$#" -gt 0 ] || set -- status

usage() {
  echo "evezctl status|mesh|observe|bluetooth|audio|mission|openclaw|hermes"
}

open_chrome() {
  url="$1"
  if [ -x /system/bin/am ]; then
    /system/bin/am start -a android.intent.action.VIEW -d "$url" -n com.android.chrome/com.google.android.apps.chrome.Main >/dev/null 2>&1 && return 0
  fi
  termux-open-url "$url"
}

probe_http() {
  name="$1"
  url="$2"
  if [ -z "$url" ]; then
    printf '%s=%s\n' "$name" "not_configured"
    return
  fi
  if ! command -v curl >/dev/null 2>&1; then
    printf '%s=%s\n' "$name" "curl_missing"
    return
  fi
  code=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 4 --max-time 8 "$url" 2>/dev/null || true)
  case "$code" in
    2??) state="ok" ;;
    3??) state="redirect" ;;
    401|403) state="reachable_auth_required" ;;
    502|503|504) state="upstream_error" ;;
    000|"") state="unreachable" ;;
    *) state="degraded_http_$code" ;;
  esac
  printf '%s=%s\n' "$name" "$state"
}

case "$1" in
  status)
    echo "node=$EVEZ_NODE_ID"
    echo "observation_configured=$([ -n "$EVEZ_OBSERVATION_URL" ] && echo yes || echo no)"
    echo "mission_configured=$([ -n "$EVEZ_NEXTCLAW_URL" ] && echo yes || echo no)"
    echo "relay_auth_configured=$([ -n "$EVEZ_RELAY_TOKEN" ] && echo yes || echo no)"
    for c in termux-battery-status termux-wifi-connectioninfo termux-audio-info termux-sensor; do
      if command -v "$c" >/dev/null 2>&1; then
        echo "$c=present"
      else
        echo "$c=missing"
      fi
    done
    ;;
  mesh)
    # GET-only probes. Never print response bodies, URLs, headers, or secrets.
    RELAY_BASE=""
    if [[ "$EVEZ_OBSERVATION_URL" == */v1/mobile/observation ]]; then
      RELAY_BASE="${EVEZ_OBSERVATION_URL%/v1/mobile/observation}"
    fi
    probe_http "relay_health" "${RELAY_BASE:+$RELAY_BASE/health}"
    probe_http "ruview_health" "${EVEZ_RUVIEW_URL%/}/health"
    probe_http "ruview_nodes" "${EVEZ_RUVIEW_URL%/}/api/v1/nodes"
    probe_http "openclaw_ui" "$EVEZ_OPENCLAW_URL"
    probe_http "hermes_ui" "$EVEZ_HERMES_URL"
    ;;
  observe)
    evez-mobile-daemon --once
    ;;
  bluetooth)
    if command -v termux-bluetooth-scaninfo >/dev/null 2>&1; then
      termux-bluetooth-scaninfo
    elif command -v termux-bluetooth-scan >/dev/null 2>&1; then
      termux-bluetooth-scan info
    elif command -v termux-audio-info >/dev/null 2>&1; then
      termux-audio-info
    else
      echo "No Bluetooth observation command is installed."
    fi
    ;;
  audio)
    termux-audio-info
    ;;
  mission)
    shift
    PROMPT="$*"
    if [ -z "$PROMPT" ]; then
      echo "mission text required" >&2
      exit 2
    fi
    if [ -z "$EVEZ_RELAY_TOKEN" ]; then
      echo "EVEZ_RELAY_TOKEN is required; refusing unauthenticated mission request." >&2
      exit 2
    fi
    if [ -z "$EVEZ_NEXTCLAW_URL" ]; then
      echo "EVEZ_NEXTCLAW_URL is not configured." >&2
      exit 2
    fi
    curl -fsS --max-time 20 \
      -H 'Content-Type: application/json' \
      -H "Authorization: Bearer $EVEZ_RELAY_TOKEN" \
      --data "$(jq -nc --arg p "$PROMPT" --arg n "$EVEZ_NODE_ID" '{prompt:$p,source_node:$n}')" \
      "$EVEZ_NEXTCLAW_URL"
    ;;
  openclaw)
    [ -n "$EVEZ_OPENCLAW_URL" ] || { echo "EVEZ_OPENCLAW_URL is not configured." >&2; exit 2; }
    open_chrome "$EVEZ_OPENCLAW_URL"
    ;;
  hermes)
    [ -n "$EVEZ_HERMES_URL" ] || { echo "EVEZ_HERMES_URL is not configured." >&2; exit 2; }
    open_chrome "$EVEZ_HERMES_URL"
    ;;
  *)
    usage
    exit 2
    ;;
esac
