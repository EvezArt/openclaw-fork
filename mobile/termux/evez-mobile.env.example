EVEZ_NODE_ID=evez-a16
EVEZ_OBSERVATION_URL=https://linux-host.example.ts.net/v1/mobile/observation
EVEZ_NEXTCLAW_URL=https://linux-host.example.ts.net/v1/mission
EVEZ_OPENCLAW_URL=https://linux-host.example.ts.net/
EVEZ_HERMES_URL=https://linux-host.example.ts.net/hermes/
# Generate a long random token and set the SAME value as EVEZ_RELAY_TOKEN on the Linux relay.
# Replace this placeholder locally; never commit the real token.
EVEZ_RELAY_TOKEN=replace-with-a-long-random-secret
EVEZ_INTERVAL_SECONDS=30
EVEZ_AUDIO_SECONDS=8
EVEZ_CAPTURE_AUDIO=false
EVEZ_DATA_DIR=$HOME/.local/share/evez-mobile
